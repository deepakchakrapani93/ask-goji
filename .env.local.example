# Supabase project URL and anon key (Settings → API in Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Optional server-only key for private storage buckets (never use NEXT_PUBLIC_ prefix)
# SUPABASE_SECRET_KEY=sb_secret_...

# Storage bucket for hunt images and audio (default: goji-assets)
# Upload files under: {bucket}/{reel_id}/growl.mp3, happy_bark.mp3, play_bark.mp3
NEXT_PUBLIC_SUPABASE_AUDIO_BUCKET=goji-assets

# Optional: load this hunt when ?reel= is omitted (e.g. on your Vercel root URL)
NEXT_PUBLIC_DEFAULT_REEL=cafe_01

# Server-only fallbacks (Vercel runtime — optional if NEXT_PUBLIC_* are set)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-or-publishable-key
# SUPABASE_AUDIO_BUCKET=goji-assets
# DEFAULT_REEL=cafe_01
