# Supabase project URL and anon key (Settings → API in Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Storage bucket name for hunt audio files (default: audio)
# Files are expected at: {bucket}/{reel_id}/growl.mp3, happy_bark.mp3, alert.mp3, etc.
NEXT_PUBLIC_SUPABASE_AUDIO_BUCKET=audio
