# Supabase project URL and anon key (Settings → API in Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Or use Supabase's newer publishable key name:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Storage bucket name for hunt audio files
# Files are expected at: {bucket}/{reel_id}/growl.mp3, happy_bark.mp3, alert.mp3, etc.
NEXT_PUBLIC_SUPABASE_AUDIO_BUCKET=goji-assets

# Optional: load this hunt when ?reel= is omitted (e.g. on your Vercel root URL)
NEXT_PUBLIC_DEFAULT_REEL=cafe_01
